@dataclass
class ClaimAudit:
    claim: Claim
    supported: bool
    detail: str


def audit_claims(claims: Optional[Tuple[Claim, ...]] = None) -> List[ClaimAudit]:
    """Run every claim's check against the repository as it is right now."""
    out: List[ClaimAudit] = []
    for claim in claims if claims is not None else CLAIMS:
        fn = CHECKS.get(claim.check)
        if fn is None:
            out.append(ClaimAudit(claim, False, f"unknown check {claim.check!r}"))
            continue
        try:
            res = fn()
        except Exception as exc:  # a check that cannot run has not passed
            out.append(ClaimAudit(claim, False, f"check raised: {exc}"))
            continue
        out.append(ClaimAudit(claim, bool(res.supported), res.detail))
    return out


def render_claims_markdown(audits: Optional[List[ClaimAudit]] = None) -> str:
    """A poster-ready table. Failed checks are printed, not dropped."""
    audits = audits if audits is not None else audit_claims()
    lines = [
        "| claim | tier | supported by | verified | limit |",
        "|---|---|---|---|---|",
    ]
    for a in audits:
        mark = "yes" if a.supported else "**NO**"
        lines.append(
            f"| {a.claim.sentence} | `{a.claim.tier.name}` | "
            f"`{a.claim.substantiated_by}` | {mark} | {a.claim.limit} |"
        )
    failures = [a for a in audits if not a.supported]
    lines.append("")
    if failures:
        lines.append(f"{len(failures)} of {len(audits)} claims failed their check:")
        for a in failures:
            lines.append(f"- **{a.claim.id}**: {a.detail}")
    else:
        lines.append(f"All {len(audits)} claims verified against the repository.")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Honesty envelope
# ---------------------------------------------------------------------------


def claims_provenance() -> Dict[str, EvidenceStatus]:
    return {
        "claim_matches_code": EvidenceStatus.ESTABLISHED,
        "mechanism_is_mechanistic": EvidenceStatus.ESTABLISHED,
        "parameters_are_measured": EvidenceStatus.PROVEN_FAILED,
        "engine_predicts_patients": EvidenceStatus.UNKNOWN,
        "clinical_benefit": EvidenceStatus.UNKNOWN,
    }


def what_these_claims_cannot_establish() -> List[str]:
    return [
        "that a mechanistic model is more likely to be right than a learned one: "
        "mechanism makes a model falsifiable and interpretable, not correct",
        "that any rate constant in this repository is measured: they are "
        "calibrated or assumed, and the tiers say which",
        "that passing the audit means a judge should believe the biology: the "
        "audit checks the code against its own sentences",
        "that the engine predicts a patient's course, or that any schedule here "
        "extends a life -- both require prospective trials",
    ]
    Claim(
        "solver_verified_against_analytic_solutions",
        "The spatial solver is verified against exact analytic solutions rather "
        "than against itself. The zero-flux Laplacian reproduces its own "
        "Neumann eigenvector to a relative residual of 3.43e-14 (float noise), "
        "its total vanishes on any closed-domain field to 3.47e-18 relative, "
        "the heterogeneous operator collapses onto the homogeneous one at "
        "constant D to 2.75e-16, and the observed order of spatial convergence "
        "is 1.9944 (second order, measured by halving dx). Its one signed "
        "discretization error -- forward Euler integrates clearance at a rate "
        "+0.0843%/day high, a direction the scheme cannot avoid -- moves no "
        "endpoint by more than 0.7505% in a paired cohort on real geometry, "
        "which is 0.0075x that cohort's own seed-to-seed spread of 99.66%.",
        EvidenceStatus.ESTABLISHED,
        "danon/claims.py::check_solver_verified_against_analytic_solutions "
        "over outputs_real/clearance_bias_cohort.json, with the same values "
        "pinned by tests/test_benchmarks.py",
        "solver_verified_against_analytic_solutions",
        "This is VERIFICATION, not validation: it says the code solves the model "
        "it states, not that the model is right about biology. No benchmark "
        "against PhysiCell, BioNetGen or FEniCS was run -- the analytic "
        "solutions used here are what such a cross-check would compare against "
        "anyway, and a matched benchmark problem is a separate pass. The bias "
        "is bounded below the model's own stochastic resolution; it is not "
        "zero, and it is not corrected, only measured. The paired cohort "
        "behind the 0.0075x is ONE case at two policies and three seeds, so it "
        "is a bound on this bias, not a general noise model.",
  ),
    Claim(
        "fresh_clone_can_run_the_twin",
        "A fresh clone can RUN the twin, not only read about it. "
        "data/sample_bids/ commits a 14 KB synthetic phantom -- three NIfTI "
        "volumes plus a config and a dataset description, all five "
        "byte-for-byte the output of the engine's own make_gbm_phantom -- and "
        "python -m danon.reproduce runs the real paired 365-day trial on it "
        "with no download. The phantom carries 3,178 tumour voxels of 13,824 at "
        "1 mm; the continuous-dose arm reaches progression in every replicate, "
        "the switching arm reaches the trial horizon in none, and the paired "
        "delta clears the arm's own seed-to-seed spread.",
        EvidenceStatus.ESTABLISHED,
        "danon/reproduce.py (danon/claims.py::"
        "check_sample_trial_runs_without_a_download) over "
        "outputs_real/sample_twin_report.json, with tests/test_reproduce.py",
        "sample_trial_runs_without_a_download",
        "It is a phantom: no part of it is measured, and the engine's constants "
        "are the repository's declared assumptions, so this demonstrates that "
        "the pipeline runs and is reproducible -- it is NOT evidence about any "
        "patient, and the MTD-versus-switching contrast is the engine's own "
        "qualitative behaviour on a synthetic substrate, not a clinical result. "
        "The sample ships homogeneous transport: the heterogeneous D(x) branch "
        "is implemented and reachable by a config flag, but costs about 19x "
        "per run at this grid, so the default keeps the command to seconds.",
  ),
    Claim(
        "uncertainty_is_measured_and_the_posterior_label_refused",
        "Uncertainty is measured rather than asserted, and the label it is NOT is "
        "stated first. Propagating the real per-donor MGMT promoter beta "
        "distribution (140 TCGA-GBM donors over two probes, mean beta band "
        "0.0119-0.6695) through both arms on a committed BraTS-2021 case gives an "
        "interval whose coverage is over (donor, seed) jointly and which is "
        "explicitly NOT a Bayesian credible interval -- a posterior needs a "
        "likelihood, and this repository holds ZERO engine-output/patient-outcome "
        "pairs to build one from (recorded as PROVEN_FAILED so no renderer can call "
        "it one). What the decomposition then establishes bounds the "
        "'patient-specific twin' story with numbers: for MTD progression-free "
        "survival, re-running the model on the SAME donor moves the answer with an "
        "SD of 29.92 days while moving to a different donor's MGMT status moves it "
        "10.38 days -- a repeat run is 2.88x the patient-specific signal, and the "
        "input does not clear a 0.05 F test (F = 1.241 on 139/140 df, p = 0.102). "
        "The day-365 burden readout DOES resolve it (input fraction 24.6%, "
        "p = 0.0016), so which endpoint is read decides whether the patient is "
        "visible at all. The arm that looks best is the worst on this axis: the "
        "switching policy's PFS is identical for every donor and every seed "
        "(365 d, no spread to decompose), and its day-365 burden is not resolvable "
        "above the model's own noise at all (MSB 1.80 < MSW 6.99, "
        "sigma^2_between <= 0, recorded unclipped).",
        EvidenceStatus.ESTABLISHED,
        "danon/claims.py::check_uncertainty_budget_separates_input_from_noise "
        "over outputs_real/uncertainty_budget.{json,txt} (rebuildable via "
        "_uncertainty_cohort.py), with danon/uncertainty.py and "
        "tests/test_uncertainty.py",
        "uncertainty_budget_separates_input_from_noise",
        "It is not a credible interval and not a clinical bound. One scalar input "
        "is measured here -- MGMT beta, the only engine input in this repository "
        "with a real per-donor distribution -- on ONE committed geometry, at ONE "
        "trial design (365 days, r0 = 0.01), through a mapping beta -> r0 that is a "
        "DECLARED convention rather than a fit, with the engine's rate constants "
        "still declared assumptions. So the input channel quantified here is a "
        "LOWER bound on the true input uncertainty, and a different anchor moves "
        "every number without any code changing. The switching arm's conclusion is "
        "about this design: it saturates at the horizon, so another horizon or "
        "switch threshold could change it. The F tests ask whether the cohort's "
        "beta spread is resolvable THROUGH THE ENGINE, which is a question about "
        "the model, not about patients, and the beta of a donor tumour is not the "
        "beta of the patient whose case would be simulated.",
  ),
    Claim(
        "grid_artifact_is_measured",
        "The engine's fixed uniform grid is measured rather than assumed, and the "
        "measurement is not flattering. On a committed BraTS-2021 case (98,447 "
        "mm^3 of expert-labelled tumour at 1 mm) the axis-aligned block majority "
        "vote the ingestion DOCUMENTS is volume-faithful -- -2.88% at 2 mm, "
        "-1.22% at the shipped 3.63 mm grid, Dice 0.9310 against the source "
        "occupancy -- while `realdata._decimate_labels` does not produce it: it "
        "agrees with that vote at Dice 0.3905 (2,316 differing voxels at the "
        "shipped grid), and in single-block probes it sends ZERO of 200 "
        "fully-tumour axis-aligned cubes to their own engine voxel, because its "
        "reshape groups contiguous runs of source voxels instead of cubes "
        "(recorded PROVEN_FAILED, with the six committed engine-ready volumes "
        "all carrying the wrong partition and a 1 mm header over 48 mm^3 "
        "voxels, understating every physical volume taken from them 48.000x). "
        "The alternative block-MAX rule that api_server applies to an oversize "
        "upload fails in the other direction: +32.91% tumour volume at the "
        "shipped grid, with 34.55% of the vote's tumour added by re-labelling "
        "blocks the majority called background. And the discretization moves "
        "the OUTCOME by more than the model's own noise: at FIXED physical "
        "diffusivity, MTD progression-free survival shifts -32.43% between the "
        "2 mm and 3.63 mm grids, which is 0.79x that cohort's own seed-to-seed "
        "spread of 41.23%, while the day-365 spatial burden shifts +43.5% "
        "(1.62x the spread) under MTD and +417.6% (7.12x) under the switching "
        "arm -- so unlike the clearance scheme's 0.0075x, this artifact is NOT "
        "below the model's resolution.",
        EvidenceStatus.ESTABLISHED,
        "danon/claims.py::check_grid_artifact_is_measured over "
        "outputs_real/grid_artifact.{json,txt} (rebuildable via "
        "_grid_artifact_cohort.py), with danon/grid_artifact.py and "
        "tests/test_grid_artifact.py",
        "grid_artifact_is_measured",
        "It measures the artifact; it does not remove it. Adaptive refinement "
        "does not exist in this repository, so the coarse grid is the last word "
        "on spatial detail: anything smaller than a majority block is gone, and "
        "the drift measured here is a LOWER bound on what a coarser-but-correct "
        "partition would show, because the shipped geometry is currently a "
        "different partition of the source rather than a faithful reduction of "
        "it. The endpoint compared is a simulated PFS under declared constants, "
        "not a patient's, and the drift is reported against the cohort's own "
        "seed spread rather than against a clinical margin. The diffusivity is "
        "anchored to 1 mm by the constant's own documentation, not by "
        "measurement, and on the anisotropic (4, 4, 3) factors no scalar D is "
        "simultaneously right along all three axes -- the engine's Laplacian is "
        "isotropic in index space, so the mm^2/day figures here are "
        "volume-equivalent. The probe samples 200 of the 8,064 blocks; the "
        "cohort is ONE case, ONE trial design (365 days, r0 = 0.01) and six "
        "seeds; and the arm that drifts most is the switching arm, whose PFS is "
        "365 days for every seed at this design, so its burden drift has no "
        "PFS counterpart to check it against.",
  ),
    Claim(
        "walk_forward_is_refused_and_reasoned",
        "Longitudinal walk-forward validation -- run the engine from day 0 and "
        "score it against the same patient's follow-up scan -- is implemented "
        "and refused, and the refusal is counted rather than asserted. The "
        "harness carries 3D Dice, Jaccard, a symmetric 95th-percentile surface "
        "distance and the TRUE Jensen-Shannon divergence, which is NOT "
        "scipy.spatial.distance.jensenshannon: for the same pair this returns "
        "0.5886 bits while scipy returns 0.6387 = sqrt(0.5886 * ln 2), so a "
        "quoted target of 'JSD < 0.15' means 0.15 bits with one and 0.0225 bits "
        "with the other. There is nothing to score: the CFB-GBM manifest in "
        "this repository declares 393 usable pairs over 168 patients and ships "
        "no images, the public NBIA API returns 0 patients and 0 segmentation "
        "series for MU-Glioma-Post (203 subjects, 596 post-treatment "
        "timepoints, DOI 10.7937/7k9k-3c83) and for Brain-Tumor-Progression, "
        "and 0 GLASS records exist in this tree -- 0 scorable pairs. What the "
        "harness establishes instead is which term moves the predicted tumour "
        "at all: the per-voxel growth map sums to exactly 0.0 outside the day-0 "
        "mask, so outward movement is the daily motility * laplacian(N) term and "
        "nothing else -- with motility forced to 0.0 the share of final burden "
        "outside the mask is exactly 0.0, with the engine's default it is 19.35% "
        "after 30 days -- and that coefficient is a VOXEL-unit literal, 0.02 "
        "voxel^2/day, worth 0.2641 mm^2/day at the engine's real 3.634 mm voxel "
        "size, 52.8x the top of the published cell-motility range (0.001-0.005 "
        "mm^2/day). A walk-forward Dice measured today would therefore be "
        "measuring that coefficient, not invasion.",
        EvidenceStatus.ESTABLISHED,
        "danon/claims.py::check_walk_forward_is_refused_and_reasoned, with "
        "danon/walkforward.py, _walkforward_census.py over "
        "outputs_real/walkforward_census.json, and tests/test_walkforward.py",
        "walk_forward_is_refused_and_reasoned",
        "The metrics are VERIFIED against constructions known on paper, not "
        "validated against patients: no Dice and no JSD has been measured on a "
        "human follow-up, and none can be until a registered pair exists -- this "
        "repository has no co-registration, so a Dice between two unregistered "
        "segmentations would be an alignment error wearing a model metric's "
        "name. The census counts what officials publish, not what a licence "
        "holder could download: MU-Glioma-Post is public to READ about and "
        "licence-locked to acquire, so '0 patients from the API' is a statement "
        "about this machine's access, not about the dataset's contents. The "
        "expansion measurement is a 16^3 synthetic cube over two seeds and 30 "
        "days in the most favourable configuration for outward movement "
        "(proliferation 1.0 inside, uniform drug inlet); it bounds the "
        "mechanism, and a real geometry would move the share. And the clonal "
        "readout refuses by construction: the engine carries two bins, so a "
        "GLASS allele-frequency spectrum would have to be summarised onto those "
        "two bins by a rule this repository has no basis for.",
  ),
    Claim(
        "ablation_separates_mechanisms",
        "Each mechanism this engine carries is ablated one at a time -- same "
        "geometry, same seeds, same policy, one parameter moved -- and the effect "
        "is reported in units of the model's own seed-to-seed spread, so a term "
        "that moves an endpoint less than the noise is not credited with doing "
        "anything. On the committed BraTS-2021 case over three seeds and 365 "
        "days the load-bearing readouts are: cell motility 5 of 8 (steering "
        "day-365 burden 4.628x the spread, MTD PFS 1.233x, the final resistant "
        "fraction 113x, dominance day 10.0x), the resistant clone's kill ceiling "
        "3 (burden 1.125x, resistant fraction 1.707x, dominance day 3.0x), the "
        "resistance fitness cost 2 (dominance day 2.333x under MTD, steering "
        "burden 2.795x), the perfusion-derived transport field 1 (steering "
        "burden 1.523x, while MTD PFS moves 0.008x -- nothing), and drug B "
        "1 (steering burden 5172.8x). Two mechanisms move NOTHING above the "
        "noise: the mutation term (every readout inert, 0.067x or less) and the "
        "asymmetric Lotka-Volterra competition coefficient (every readout inert "
        "or unresolved). The control that makes those nulls credible is built "
        "into the design: MTDPolicy doses (1.0, 0.0), so ablating drug B under "
        "the MTD arm must be exactly zero, and it is -- on every one of the four "
        "readouts, in the phantom and in the real case.",
        EvidenceStatus.ESTABLISHED,
        "danon/claims.py::check_ablation_separates_mechanisms, with "
        "danon/ablation.py, _ablation_cohort.py over "
        "outputs_real/ablation_cohort.json, and tests/test_ablation.py",
        "ablation_separates_mechanisms",
        "Load-bearing is not correct. A wrong coefficient and a right one produce "
        "the same positive effect size when the same model is ablated, so this "
        "says which parts of THIS model the answer depends on, not that they are "
        "the mechanisms a real tumour uses. Inert is not falsified either: a "
        "mechanism can be inert because it is wrong or because it is second-order "
        "at this design, and the verdict of 'unresolved' (the ratio between "
        "0.1x and 1.0x) is the honest middle that this design cannot settle. The "
        "mutation null has a mechanical reason worth stating: with no pre-seeded "
        "resistance (r0 = 0) continuous MTD eradicates the tumour to a burden of "
        "exactly 0.000 at day 365 for every seed and at both mutation rates, so "
        "this model's resistance is its 1% initial condition, not its mutation "
        "channel. The endpoints are simulated PFS and burden under declared "
        "constants, on ONE case, one trial design and three seeds; and no "
        "diffusion-tensor map exists here, so an 'anisotropic tensor PDE' is not "            "what the transport ablation removes -- it removes the spatial variation "
        "of a scalar field.",
  ),
    Claim(
        "acceleration_is_bit_identical_and_measured",
        "The accelerated solver is faster by a measured factor and by nothing else: "
        "every kernel reproduces its own reference BIT FOR BIT. Removing the "
        "Python-level `np.pad` copies and the boolean masks from the two hot "
        "operators -- holding the summation order fixed, since float addition is "
        "not associative -- buys 1.25x / 2.32x at the engine's own 14x24x24 grid, "
        "1.71x / 3.17x at 64^3 and 2.47x / 3.54x at 256^3 (Laplacian / "
        "div-divergence), and a reuse workspace keeps the per-day cost at 1.117x "
        "for homogeneous transport and 1.904x when the transport field is "
        "heterogeneous. Identity is the gate, not a tolerance: a one-ulp change "
        "in a diffusion flux is amplified by 365 iterations of a nonlinear map, "
        "so the tests compare whole arrays, whole trajectories and whole "
        "replicate batches with exact equality. The two obvious ways to buy the "
        "rest do NOT work here and are recorded as measured rather than assumed: "
        "batching replicates into one leading array axis is a measured SLOWDOWN "
        "(0.833x the serial rate at 16 replicates x 60 days with per-replicate "
        "streams, 0.862x with one batched draw -- so it is not the RNG), because "
        "an 8,064-voxel field is 64 KB and forty numpy calls on it are dominated "
        "by per-call cost; and there is no GPU, no JAX and no CuPy in this "
        "environment, so no GPU figure exists to quote. What DOES scale is "
        "running the replicates in OS processes, which cannot change a number "
        "because each worker runs the unmodified serial engine on its own seeds: "
        "2.080x at 4 workers and 2.006x at 8 on 12 cores, which puts a 10,000-draw "
        "365-day sweep at 1.41-1.46 extrapolated hours instead of 2.94 serial.",
        EvidenceStatus.ESTABLISHED,
        "danon/claims.py::check_acceleration_is_bit_identical_and_measured over "
        "outputs_real/perf.json (rebuildable via _perf_cohort.py), with "
        "danon/accel.py, danon/uq.py, tests/test_accel.py, tests/test_batchsim.py "
        "and tests/test_uq.py",
        "acceleration_is_bit_identical_and_measured",
        "These are speedups of THIS engine on THIS machine, not of the problem. "
        "The ratios are minima over interleaved repetitions on a shared machine "
        "whose own 30-day timing varied 2.7x across 12 consecutive runs, so every "
        "figure here is the cost of the work rather than a peak, and none of them "
        "transfers to another box. The 256^3 operator numbers are one call each, "
        "not a trajectory: no 365-day run at that grid was measured, and the "
        "engine's own cases are 8,064-voxel grids, so 256^3 is a scaling probe "
        "and not a workload this repository runs. The process ratios are "
        "measured at 4 and 8 workers with 16 replicates and do NOT reach the "
        "12-core count, so the extrapolated 10,000-draw figure is arithmetic on a "
        "ratio that will not hold on a busy machine, over a grid far smaller than "
