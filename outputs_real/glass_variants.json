  "what_is_refused": {
    "point_clone_fraction": "refused: a point clone fraction would require a copy number, a purity and a cellularity model, none of which this release carries; a lower bound is published instead of a point",
    "upper_bound_on_clone_fraction": "refused: an upper bound on the clone fraction needs the local copy number (f = A_t * total/variant copies), and the mutation records of this release carry no copy number or purity field -- so only a lower bound is published",
    "two_bin_summarisation": "refused: this spectrum has k bins and the engine has 2, so it cannot be scored as a clone state -- danon.walkforward.clonal_jsd refuses a support of a different size by construction, and no summarisation rule from a k-bin allele-frequency spectrum onto a two-bin cell-population fraction exists in this repository",
    "lower_bound_derivation": "A_t = f * (variant copies / total copies) and variant copies <= total copies, so A_t <= f: the measured tumour allele fraction is a lower bound on the fraction of tumour cells carrying the variant"
  },
  "provenance": {
    "allele_fraction_from_read_counts": "established",
    "clone_fraction_lower_bound": "established",
    "somatic_assumption": "unknown",
